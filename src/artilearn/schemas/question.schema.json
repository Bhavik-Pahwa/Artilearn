{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artilearn/question.schema.json",
  "title": "Question item (PRD Sec. 9, ASM-02, ASM-08)",
  "type": "object",
  "required": ["id", "concept_ids", "syllabus_unit", "type", "difficulty", "provenance", "stem",
               "explanation", "source_links", "validation"],
  "properties": {
    "id": {"type": "string"},
    "concept_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "syllabus_unit": {"type": ["string", "null"]},
    "type": {"enum": ["mcq", "short_answer", "conceptual", "numeric"]},
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "provenance": {"enum": ["official", "ai_generated"]},
    "stem": {"type": "string", "minLength": 1},
    "options": {"type": "array", "items": {"type": "string"}},
    "key": {},
    "rubric": {"type": "array", "items": {"type": "string"}},
    "explanation": {"type": "string"},
    "source_links": {"type": "array", "minItems": 1},
    "validation": {
      "type": "object",
      "required": ["status", "checks", "validator_versions"],
      "properties": {
        "status": {"enum": ["draft", "validated", "rejected", "human_review"]},
        "checks": {
          "type": "array",
          "items": {"type": "object", "required": ["name", "result"],
                    "properties": {"result": {"enum": ["pass", "fail", "skipped"]}}}
        },
        "validator_versions": {"type": "object"}
      }
    }
  },
  "oneOf": [{"required": ["key"]}, {"required": ["rubric"]}],
  "allOf": [
    {"if": {"properties": {"type": {"const": "mcq"}}}, "then": {"required": ["options", "key"]}}
  ]
}
